# ============================================
# 自动化测试平台 环境配置模板
# 复制为 .env 后按需修改
# ============================================

# 服务端口
PORT=8000

# JWT 密钥（生产环境请改为随机长字符串）
SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 全局并发执行上限（同时最多运行多少个任务）
MAX_CONCURRENT_RUNS=3

# ---------- GitHub 配置 ----------
# 拉取私有仓库时需要（生成地址：GitHub -> Settings -> Developer settings -> Personal access tokens）
GITHUB_TOKEN=
# 拉取代码时的超时时间（秒）
GIT_TIMEOUT=120
# GitHub 访问镜像前缀（国内网络拉取 github.com 失败时使用）
# 常见可用镜像：https://ghfast.top/  https://gh-proxy.com/  https://gitclone.com/github.com/
GIT_CLONE_PREFIX=

# ---------- AI Bug 分析配置 ----------
# 留空则使用内置规则引擎（不消耗 API，但能力有限）
# 兼容 OpenAI 格式的任意服务：OpenAI / 豆包火山方舟 / DeepSeek / 通义千问 / 智谱 等
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 分析时读取日志的最大字符数（避免超长日志）
LLM_MAX_LOG_CHARS=8000
# 分析超时（秒）
LLM_TIMEOUT=60
